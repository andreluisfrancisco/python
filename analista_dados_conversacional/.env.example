# Copie para .env:  cp .env.example .env
#
# Um único Postgres na máquina, o de database/postgres, em 127.0.0.1:5432.
# Database: app. Este projeto usa o schema analista.
# As senhas são POSTGRES/MIGRATION/DEVELOPER daquele .env.
# Na URL, encode a senha (python: urllib.parse.quote(senha, safe="")).

DATABASE_URL=postgresql://developer:SENHA_ENCODED@127.0.0.1:5432/app
MIGRATION_DATABASE_URL=postgresql://migration:SENHA_ENCODED@127.0.0.1:5432/app

# Chave em https://console.x.ai/ — sem ela a API sobe, mas o chat responde 503.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1
EMBEDDING_MODEL=v1
EMBEDDING_DIMENSIONS=768

JWT_SECRET=
JWT_TTL_MINUTES=720

SQL_ROW_LIMIT=200
SQL_TIMEOUT_MS=5000
HISTORY_MAX_MESSAGES=12
CATALOG_TOP_K=4

# Usuário criado pelo scripts/init_db.py. Senha fraca de propósito, só demo local.
DEMO_USER_EMAIL=demo@aurora.local
DEMO_USER_PASSWORD=demo1234
DEMO_USER_NAME=Ana Demo

API_BASE_URL=http://localhost:8000
